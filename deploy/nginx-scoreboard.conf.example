# Include these locations in the existing TLS-enabled scoreboard server block.
# oauth2-proxy is expected to listen on loopback port 4180.

# Increase proxy header buffer sizes for oauth2-proxy responses containing groups/roles
proxy_buffer_size 16k;
proxy_buffers 4 32k;
proxy_busy_buffers_size 64k;

location /oauth2/ {
    proxy_pass http://127.0.0.1:4180;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Auth-Request-Redirect $request_uri;
}

location = /oauth2/auth {
    proxy_pass http://127.0.0.1:4180/oauth2/auth;

    proxy_pass_request_body off;
    proxy_set_header Content-Length "";

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Uri $request_uri;
}

location @oauth2_signin {
    return 302 /oauth2/sign_in?rd=$request_uri;
}

location = /admin {
    auth_request /oauth2/auth;
    error_page 401 = @oauth2_signin;

    auth_request_set $authenticated_email $upstream_http_x_auth_request_email;
    auth_request_set $authenticated_user $upstream_http_x_auth_request_user;
    auth_request_set $authenticated_preferred_username $upstream_http_x_auth_request_preferred_username;
    auth_request_set $authenticated_roles $upstream_http_x_auth_request_roles;
    auth_request_set $authenticated_groups $upstream_http_x_auth_request_groups;

    proxy_set_header X-Auth-Request-Email $authenticated_email;
    proxy_set_header X-Auth-Request-User $authenticated_user;
    proxy_set_header X-Auth-Request-Preferred-Username $authenticated_preferred_username;
    proxy_set_header X-Auth-Request-Roles $authenticated_roles;
    proxy_set_header X-Auth-Request-Groups $authenticated_groups;

    proxy_pass http://127.0.0.1:3080;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /admin/ {
    auth_request /oauth2/auth;
    error_page 401 = @oauth2_signin;

    auth_request_set $authenticated_email $upstream_http_x_auth_request_email;
    auth_request_set $authenticated_user $upstream_http_x_auth_request_user;
    auth_request_set $authenticated_preferred_username $upstream_http_x_auth_request_preferred_username;
    auth_request_set $authenticated_roles $upstream_http_x_auth_request_roles;
    auth_request_set $authenticated_groups $upstream_http_x_auth_request_groups;

    proxy_set_header X-Auth-Request-Email $authenticated_email;
    proxy_set_header X-Auth-Request-User $authenticated_user;
    proxy_set_header X-Auth-Request-Preferred-Username $authenticated_preferred_username;
    proxy_set_header X-Auth-Request-Roles $authenticated_roles;
    proxy_set_header X-Auth-Request-Groups $authenticated_groups;

    proxy_pass http://127.0.0.1:3080;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /api/admin/ {
    auth_request /oauth2/auth;

    auth_request_set $authenticated_email $upstream_http_x_auth_request_email;
    auth_request_set $authenticated_user $upstream_http_x_auth_request_user;

# Host address and port to bind on the Docker host (defaults: 127.0.0.1 and 3080)
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3080

# Local authentication - uncomment both variables to enable a built-in
# login screen instead of relying on oauth2-proxy / X-Auth-Request-* headers.
# LOCAL_AUTH_USER=admin
# LOCAL_AUTH_PASSWORD=changeme
# LOCAL_AUTH_SECRET= # optional - leave blank to auto-generate per restart

# Keycloak / oauth2-proxy configuration (when using external or integrated proxy)
# OAUTH2_PROXY_OIDC_ISSUER_URL=https://keycloak.example.com/realms/homelab
# OAUTH2_PROXY_CLIENT_ID=bewerb-oauth2-proxy
# OAUTH2_PROXY_CLIENT_SECRET=
# OAUTH2_PROXY_COOKIE_SECRET=
